   "notes": [
    {
     "id": "note1",
     "x": 40,
     "y": 20,
     "w": 700,
     "h": 80,
     "text": "Loads a 16-pixel row into a RAM (one pixel per cycle while load=1), then reads it back with a horizontal offset against a 16-pixel reference row stored in a ROM, accumulating the sum of absolute differences (SAD) — the core operation of a block-matching motion estimator. The reference is 0,1,…,15; the loaded row is the same, so with offset=0 the SAD is 0, and with offset=1 it is 30 (a wrap-around read makes the last pixel disagree by 15)."
    }
   ],
   "locked": []
  }
 },
