     "params": {
      "width": 8,
      "value": 100
     },
     "x": 40,
     "y": 190,
     "trace": true,
     "label": "b"
    },
    {
     "id": "add1",
     "type": "add",
     "params": {
      "width": 8,
      "cin": false,
      "cout": true
     },
     "x": 260,
     "y": 120,
     "trace": false
    },
    {
     "id": "s",
     "type": "out",
     "params": {
      "width": 8
     },
     "x": 420,
     "y": 127,
     "trace": true,
     "label": "sum"
    },
