{
 "version": 2,
 "name": "Accumulator",
 "top": "top",
 "options": {
  "resetStyle": "sync_high",
  "xUntilReset": false,
  "clockName": "clk",
  "resetName": "rst"
 },
 "modules": {
  "top": {
   "source": "schematic",
   "ports": [],
   "blocks": [
    {
     "id": "x",
     "type": "in",
     "params": {
      "width": 8,
      "value": 3
     },
     "x": 40,
     "y": 110,
     "trace": true,
     "label": "x"
    },
    {
     "id": "en",
     "type": "in",
     "params": {
      "width": 1,
      "value": 1
     },
     "x": 40,
     "y": 250,
     "trace": true,
     "label": "en"
    },
    {
     "id": "add1",
     "type": "add",
     "params": {
      "width": 8,
      "cin": false,
      "cout": false
     },
     "x": 240,
     "y": 100,
     "trace": false
    },
    {
     "id": "lbl_in",
     "type": "label",
     "params": {
      "name": "acc",
      "width": 8
     },
     "x": 120,
     "y": 152,
     "trace": false
    },
    {
     "id": "reg1",
     "type": "reg",
     "params": {
      "width": 8,
      "en": true,
      "rst": "sync",
      "init": 0
     },
     "x": 400,
     "y": 110,
     "trace": true,
     "label": "acc"
    },
    {
     "id": "lbl_out",
     "type": "label",
     "params": {
      "name": "acc",
      "width": 8
     },
     "x": 560,
     "y": 117,
     "trace": false
    },
    {
     "id": "y",
     "type": "out",
     "params": {
      "width": 8
     },
     "x": 560,
     "y": 170,
     "trace": true,
     "label": "acc"
    }
   ],
   "wires": [
    {
     "id": "w1",
     "from": {
      "b": "x",
      "p": "y"
     },
     "to": {
      "b": "add1",
      "p": "a"
     }
    },
    {
     "id": "w2",
     "from": {
      "b": "lbl_in",
      "p": "o"
     },
     "to": {
      "b": "add1",
      "p": "b"
     }
    },
    {
     "id": "w3",
     "from": {
      "b": "add1",
      "p": "s"
     },
     "to": {
      "b": "reg1",
      "p": "d"
     }
    },
    {
     "id": "w4",
     "from": {
      "b": "en",
      "p": "y"
     },
     "to": {
      "b": "reg1",
      "p": "en"
     }
    },
    {
     "id": "w5",
     "from": {
      "b": "reg1",
      "p": "q"
     },
     "to": {
      "b": "lbl_out",
      "p": "i"
     }
    },
    {
     "id": "w6",
     "from": {
      "b": "reg1",
      "p": "q"
     },
     "to": {
      "b": "y",
      "p": "a"
     },
     "mid": 530
    }
   ],
   "notes": [
    {
     "id": "note1",
     "x": 40,
     "y": 20,
     "w": 620,
     "h": 50,
     "text": "acc <= acc + x on every enabled clock. The net label \"acc\" carries Q back to the adder without a long wire. Hold Reset and clock once to clear it."
    }
   ],
   "locked": []
  }
 },
 "tests": [
  {
   "name": "Accumulate 3s then reset",
