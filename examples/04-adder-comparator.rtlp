     "id": "co",
     "type": "out",
     "params": {
      "width": 1
     },
     "x": 420,
     "y": 151,
     "trace": true,
     "label": "carry"
    },
    {
     "id": "cmp1",
     "type": "cmp",
     "params": {
      "width": 8,
      "op": "eq",
      "signed": false
     },
     "x": 260,
     "y": 260,
     "trace": false
    },
    {
     "id": "eq",
     "type": "out",
     "params": {
      "width": 1
     },
     "x": 420,
     "y": 271,
     "trace": true,
     "label": "a == b"
    }
   ],
   "wires": [
    {
     "id": "w1",
     "from": {
      "b": "a",
      "p": "y"
     },
     "to": {
      "b": "add1",
      "p": "a"
     }
    },
    {
     "id": "w2",
     "from": {
