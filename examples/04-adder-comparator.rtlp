     "id": "w7",
     "from": {
      "b": "cmp1",
      "p": "y"
     },
     "to": {
      "b": "eq",
      "p": "a"
     }
    }
   ],
   "notes": [
    {
     "id": "note1",
     "x": 40,
     "y": 20,
     "w": 560,
     "h": 50,
     "text": "An 8-bit adder with carry-out and an equality comparator. Try a + b > 255 to see the carry. Hover a bus to read its value in binary and hex."
    }
   ],
   "locked": []
  }
 },
